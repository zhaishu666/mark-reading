<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven 工程描述文件：定义本项目的坐标、编译级别、依赖与插件 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- POM 模型版本，固定写 4.0.0，Maven 2 之后都是这个值 -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 组织/作者标识，与源码包名前缀保持一致 -->
    <groupId>com.mark</groupId>
    <!-- 项目（构件）名称，决定打包后的 jar 文件名 -->
    <artifactId>mark-reader</artifactId>
    <!-- 项目版本号，0.1.0 表示第一个可用版本 -->
    <version>0.1.0</version>
    <!-- 打包类型为 jar，即普通 Java 应用 -->
    <packaging>jar</packaging>

    <!-- 项目显示名称，仅用于报告展示 -->
    <name>马克阅读</name>
    <!-- 项目描述 -->
    <description>纯 Java 命令行书摘管理工具：添加书籍、记录书摘、按书查询、阅读统计</description>

    <properties>
        <!-- 编译目标 Java 版本：用 release 而不是 source/target，可避免链接到更高版本 API -->
        <maven.compiler.release>17</maven.compiler.release>
        <!-- 源码与资源文件统一使用 UTF-8，防止中文书摘写入乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 报告输出编码同样指定为 UTF-8 -->
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- JUnit 5 版本号，抽成属性便于日后统一升级 -->
        <junit.version>5.10.2</junit.version>
        <!-- JaCoCo 版本号，抽成属性便于统一升级 -->
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <dependencies>
        <!-- JUnit 5 测试框架：聚合包，包含 api / engine / params 等 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <!-- test 作用域表示仅参与编译与运行测试，不会打进最终产物 -->
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 编译插件：显式锁定版本，保证不同机器上编译行为一致 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- 测试插件：负责在 mvn test 阶段发现并执行 JUnit 5 用例 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- 打包插件：把启动类写入 jar 清单，使 java -jar 可直接运行 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <!-- 指定程序入口类，供 java -jar 使用 -->
                            <mainClass>com.mark.reader.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- 执行插件：提供 mvn exec:java 直接启动程序的能力，方便开发期调试 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <!-- 指定 exec:java 启动的主类 -->
                    <mainClass>com.mark.reader.Main</mainClass>
                </configuration>
            </plugin>

            <!--
                代码覆盖率插件 JaCoCo：
                在测试阶段挂载 Java Agent 采集行/分支覆盖数据，并生成 HTML 报告。

                注意：覆盖率数据文件必须放在纯 ASCII 路径（本机 E:/jacoco-data）。
                JaCoCo 在 native 层解析 -javaagent 的 destfile 参数时不做编码转换，
                若路径含中文（如本机用户名「翟曙」），JVM 会直接崩溃：
                "processing of -javaagent failed, processJavaStart failed"。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <!-- 执行 1：测试开始前，准备 Agent 采集运行时覆盖数据 -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <!-- prepare-agent 目标会把 agent 参数注入 surefire，使其随测试启动 -->
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!--
                                destFile 是 prepare-agent 的参数名（与 report 的 dataFile 不同）。
                                必须指向纯 ASCII 路径，否则 -javaagent 的 destfile 参数会导致 JVM 崩溃。
                            -->
                            <destFile>E:/jacoco-data/jacoco.exec</destFile>
                        </configuration>
                    </execution>

                    <!-- 执行 2：测试结束后，把采集到的 .exec 二进制数据渲染成报告 -->
                    <execution>
                        <id>report</id>
                        <!-- 绑定到 test 阶段，保证 mvn test 后立刻能看报告 -->
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <!-- dataFile 是 report 目标的参数名，需与上面的 destFile 保持一致 -->
                            <dataFile>E:/jacoco-data/jacoco.exec</dataFile>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <!-- 报告输出目录，HTML 入口为 index.html -->
                    <outputDirectory>${project.reporting.outputDirectory}/jacoco</outputDirectory>
                    <!-- 排除不参与统计的类 -->
                    <excludes>
                        <!-- 程序入口类只有一句组装调用，无逻辑可覆盖 -->
                        <exclude>com/mark/reader/Main.class</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
